# Copy this file to .env and fill in your own values. Never commit .env.

# true = print posts and replies instead of sending them to X
DRY_RUN=true

# X (Twitter) API keys for the @askLens account, from developer.x.com
# Needs "Read and write" permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Solana RPC for reading coin data (the free public one works but is rate limited)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Schedule
POST_INTERVAL_HOURS=4
SUMMARY_HOUR_UTC=14
MENTION_CHECK_MINUTES=15
MAX_REPLIES_PER_USER_PER_DAY=5
